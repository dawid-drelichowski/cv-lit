{
  "name": "cv-lit",
  "version": "2.0.0",
  "description": "My CV as Lit components",
  "source": "src/index.html",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "eleventy && prettier --write src/index.html",
    "dev": "vite",
    "build": "npm run generate && vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "lint": "npm run lint:lit-analyzer && npm run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:lit-analyzer": "lit-analyzer",
    "test": "playwright install chromium && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawid-drelichowski/cv-lit.git"
  },
  "keywords": [
    "CV",
    "LitElement"
  ],
  "author": "Dawid Drelichowski",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.68.0",
    "@percy/cli": "^1.33.1",
    "@percy/playwright": "^1.1.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^25.9.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-yml": "^3.5.0",
    "globals": "^17.14.0",
    "js-yaml": "^5.1.0",
    "lit-analyzer": "^2.0.3",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-checker": "^1.0.0"
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
